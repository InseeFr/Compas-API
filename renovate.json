{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "stabilityDays": 1,
  "packageRules": [
    {
      "groupSlug": "patch",
      "branchName": "renovate/patch",
      "matchUpdateTypes": ["patch"],
      "prTitle": "Renovate : all  patch updates",
      "automerge": true,
      "minimumReleaseAge": "1 day"
    }
  ]
}
